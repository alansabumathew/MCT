# Block private folders and files
RedirectMatch 403 ^/(data|lib|templates|vendor|tools)(/|$)
<FilesMatch "^(config(\.sample)?\.php|composer\.(json|lock)|\.gitignore)$">
  Require all denied
</FilesMatch>
Options -Indexes

# Clean URLs: serve /about from about.html, and redirect /about.html -> /about
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(about|causes|gallery|contact|donate|privacy|terms)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(about|causes|gallery|contact|donate|privacy|terms)$ $1.html [L]
